---
import { lienRendezVous } from '@/lib/whatsapp'

const LIENS = [
  { href: '/collections', libelle: 'Collections' },
  { href: '/patrimoine', libelle: 'Patrimoine' },
  { href: '/inspiration', libelle: 'Inspiration' },
  { href: '/qui-suis-je', libelle: 'Qui suis-je' },
  { href: '/contact', libelle: 'Contact' },
]

const chemin = Astro.url.pathname
const rendezVous = lienRendezVous()
---

<header class="sticky top-0 z-40 border-b border-encre bg-papier">
  <div class="flex items-center justify-between gap-6 px-5 py-4 md:px-8">
    <a href="/" class="shrink-0" aria-label="Lucas Hage, accueil">
      <img
        src="/logo.svg"
        alt="Monogramme HL de Lucas Hage"
        width="26"
        height="32"
        loading="eager"
        fetchpriority="high"
        class="h-8 w-auto"
      />
    </a>

    <nav class="hidden md:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-7">
        {
          LIENS.map(({ href, libelle }) => (
            <li>
              <a
                href={href}
                class="libelle text-encre transition-colors hover:text-plomb aria-[current=page]:underline aria-[current=page]:underline-offset-4"
                aria-current={chemin.startsWith(href) ? 'page' : undefined}
              >
                {libelle}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={rendezVous}
            target="_blank"
            rel="noopener noreferrer"
            class="libelle border border-encre bg-encre px-4 py-2.5 text-papier transition-colors hover:bg-papier hover:text-encre"
          >
            Prendre rendez-vous
          </a>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      id="menu-bouton"
      class="libelle -mr-2 px-2 py-2 text-encre md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      Menu
    </button>
  </div>

  <!-- Menu plein écran, mobile uniquement. -->
  <div
    id="menu-mobile"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Navigation"
    class="fixed inset-0 z-40 flex flex-col bg-papier md:hidden"
  >
    <div class="flex items-center justify-between border-b border-encre px-5 py-4">
      <span class="libelle text-encre">Navigation</span>
      <button type="button" id="menu-fermer" class="libelle -mr-2 px-2 py-2 text-encre">
        Fermer
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-5 py-10" aria-label="Navigation mobile">
      <ul class="flex flex-col gap-7">
        {
          LIENS.map(({ href, libelle }) => (
            <li>
              <a
                href={href}
                class="font-titre text-intertitre text-encre"
                aria-current={chemin.startsWith(href) ? 'page' : undefined}
              >
                {libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-encre px-5 py-5">
      <a
        href={rendezVous}
        target="_blank"
        rel="noopener noreferrer"
        class="libelle block bg-encre px-4 py-4 text-center text-papier"
      >
        Prendre rendez-vous
      </a>
    </div>
  </div>
</header>

<script>
  const bouton = document.getElementById('menu-bouton')
  const fermer = document.getElementById('menu-fermer')
  const menu = document.getElementById('menu-mobile')

  if (bouton && fermer && menu) {
    const focalisables = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      )

    const ouvrir = () => {
      menu.hidden = false
      bouton.setAttribute('aria-expanded', 'true')
      document.documentElement.style.overflow = 'hidden'
      focalisables()[0]?.focus()
    }

    const refermer = () => {
      menu.hidden = true
      bouton.setAttribute('aria-expanded', 'false')
      document.documentElement.style.overflow = ''
      bouton.focus()
    }

    bouton.addEventListener('click', ouvrir)
    fermer.addEventListener('click', refermer)

    document.addEventListener('keydown', (evenement) => {
      if (menu.hidden) return

      if (evenement.key === 'Escape') {
        refermer()
        return
      }

      // Le clavier reste enferme dans le menu tant qu'il est ouvert.
      if (evenement.key === 'Tab') {
        const elements = focalisables()
        if (elements.length === 0) return

        const premier = elements[0]!
        const dernier = elements[elements.length - 1]!
        const actif = document.activeElement

        if (evenement.shiftKey && actif === premier) {
          evenement.preventDefault()
          dernier.focus()
        } else if (!evenement.shiftKey && actif === dernier) {
          evenement.preventDefault()
          premier.focus()
        }
      }
    })

    // Le menu plein ecran n'a plus de raison d'etre en vue bureau.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (vue) => {
      if (vue.matches && !menu.hidden) refermer()
    })
  }
</script>
