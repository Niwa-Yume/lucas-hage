---
interface Props {
  /**
   * Vrai sur une page qui s'ouvre sur une image plein cadre : le menu,
   * fixe et sans fond, se pose dessus. Il est dessine en blanc avec
   * mix-blend-mode: difference, donc blanc sur l'image et noir sur le
   * fond blanc, sans bascule scriptee ni fond ajoute au scroll.
   */
  menuSurImage?: boolean
}

const { menuSurImage = false } = Astro.props

const chemin = Astro.url.pathname

// Longueurs de filets volontairement fixees, croissantes a l'interieur
// de chaque groupe : la hierarchie se lit a la longueur du trait.
const MENU_GAUCHE = [
  { href: '/', libelle: 'Accueil', filet: 88 },
  { href: '/collections', libelle: 'Collections', filet: 120 },
]

const PAGES_MENU = [
  { href: '/qui-suis-je', libelle: 'Qui suis-je', filet: 112 },
  { href: '/inspiration', libelle: 'Inspiration', filet: 144 },
]

const estActif = (href: string) => chemin === href.split('?')[0]
---

<header
  class:list={[
    'z-40 w-full',
    menuSurImage
      ? 'fixed inset-x-0 top-0 text-papier mix-blend-difference'
      : 'relative bg-papier text-encre',
  ]}
  data-menu-sur-image={menuSurImage ? '' : undefined}
>
  <!-- Barre compacte sous 1024px -->
  <div class="flex items-center justify-between px-5 py-4 lg:hidden">
    <a href="/" aria-label="Lucas Hage, accueil">
      <img
        src="/logo.svg"
        alt="Monogramme HL de Lucas Hage"
        width="26"
        height="32"
        loading="eager"
        fetchpriority="high"
        class:list={['h-8 w-auto', menuSurImage && 'brightness-0 invert']}
      />
    </a>

    <button
      type="button"
      id="menu-bouton"
      class="flex flex-col items-end gap-[6px] p-2"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <span class="block h-px w-4 bg-current" aria-hidden="true"></span>
      <span class="block h-px w-[22px] bg-current" aria-hidden="true"></span>
      <span class="block h-px w-7 bg-current" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Menu deux colonnes, a partir de 1024px -->
  <nav class="hidden lg:block" aria-label="Navigation principale">
    <div class="flex items-start justify-between">
      <div
        class:list={[
          'menu-colonne flex flex-col gap-3',
          menuSurImage ? 'pt-14' : 'pt-8',
        ]}
      >
        <a
          href="/"
          class="item flex items-center gap-3"
          style="--l:88px"
          aria-current={estActif('/') ? 'page' : undefined}
        >
          <span class="filet" aria-hidden="true" />
          <span class="menu-texte">Accueil</span>
        </a>

        <a
          href="/collections"
          class="item flex items-center gap-3"
          style="--l:120px"
          aria-current={estActif('/collections') ? 'page' : undefined}
        >
          <span class="filet" aria-hidden="true" />
          <span class="menu-texte">Collections</span>
        </a>

        <a
          href="/contact"
          class="item flex items-center gap-3"
          style="--l:152px"
          aria-current={estActif('/contact') ? 'page' : undefined}
        >
          <span class="filet" aria-hidden="true"></span>
          <span class="menu-texte">Rencontrons-nous</span>
        </a>
      </div>

      <div class:list={['menu-colonne', menuSurImage ? 'pt-14' : 'pt-8']}>
        <ul class="flex flex-col items-end gap-3">
          {
            PAGES_MENU.map(({ href, libelle, filet }) => (
              <li>
                <a
                  href={href}
                  class="item flex items-center justify-end gap-3"
                  style={`--l:${filet}px`}
                  aria-current={estActif(href) ? 'page' : undefined}
                >
                  <span class="menu-texte">{libelle}</span>
                  <span class="filet" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<!-- Panneau plein ecran, sous 1024px. Hors du <header> pour echapper
     au mix-blend-mode : il reste blanc, texte encre, en toutes circonstances. -->
<div
  id="menu-mobile"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
  class="fixed inset-0 z-50 flex flex-col overflow-y-auto bg-papier text-encre lg:hidden"
>
  <div class="flex items-center justify-end px-5 py-4">
    <button type="button" id="menu-fermer" class="menu-texte p-2">Fermer</button>
  </div>

  <nav class="flex-1 pb-16" aria-label="Navigation mobile">
    <ul class="flex flex-col gap-3 px-5">
      <li>
        <a href="/" class="item flex items-center gap-3 py-1" style="--l:88px">
          <span class="filet" aria-hidden="true"></span>
          <span class="menu-texte">Accueil</span>
        </a>
      </li>
      <li>
        <a href="/collections" class="item flex items-center gap-3 py-1" style="--l:120px">
          <span class="filet" aria-hidden="true"></span>
          <span class="menu-texte">Collections</span>
        </a>
      </li>
      <li>
        <a href="/contact" class="item flex items-center gap-3 py-1" style="--l:152px">
          <span class="filet" aria-hidden="true"></span>
          <span class="menu-texte">Rencontrons-nous</span>
        </a>
      </li>
    </ul>

    <ul class="mt-16 flex flex-col gap-3 px-5">
      {
        PAGES_MENU.map(({ href, libelle, filet }) => (
          <li>
            <a
              href={href}
              class="item flex items-center gap-3 py-1"
              style={`--l:${filet}px`}
            >
              <span class="filet" aria-hidden="true" />
              <span class="menu-texte">{libelle}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  /* Les colonnes touchent les bords : aucun padding horizontal commun.
     Le padding-top varie selon menuSurImage (voir classes Tailwind sur le composant). */
  .menu-colonne {
    padding-bottom: 28px;
  }

  .menu-texte {
    font-size: var(--text-libelle);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    /* La couleur suit le contexte : blanc sur le hero, encre sur fond blanc. */
    color: currentColor;
  }

  /* Filet horizontal : part du bord de la fenetre et s'arrete a 12px du texte. */
  .filet {
    display: block;
    height: 1px;
    width: var(--l);
    flex: none;
    background: currentColor;
    transition: width 200ms ease;
  }

  .item:hover .filet {
    width: calc(var(--l) + 8px);
  }

  /* Contour de focus blanc : le mode difference le rend noir sur fond
     blanc et blanc sur l'image, toujours visible. */
  [data-menu-sur-image] :focus-visible {
    outline-color: var(--color-papier);
  }
</style>

<script>
  const bouton = document.getElementById('menu-bouton')
  const fermer = document.getElementById('menu-fermer')
  const menu = document.getElementById('menu-mobile')

  if (bouton && fermer && menu) {
    const focalisables = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      )

    const ouvrir = () => {
      menu.hidden = false
      bouton.setAttribute('aria-expanded', 'true')
      document.documentElement.style.overflow = 'hidden'
      focalisables()[0]?.focus()
    }

    const refermer = () => {
      menu.hidden = true
      bouton.setAttribute('aria-expanded', 'false')
      document.documentElement.style.overflow = ''
      bouton.focus()
    }

    bouton.addEventListener('click', ouvrir)
    fermer.addEventListener('click', refermer)

    document.addEventListener('keydown', (evenement) => {
      if (menu.hidden) return

      if (evenement.key === 'Escape') {
        refermer()
        return
      }

      // Le clavier reste enferme dans le menu tant qu'il est ouvert.
      if (evenement.key === 'Tab') {
        const elements = focalisables()
        if (elements.length === 0) return

        const premier = elements[0]!
        const dernier = elements[elements.length - 1]!
        const actif = document.activeElement

        if (evenement.shiftKey && actif === premier) {
          evenement.preventDefault()
          dernier.focus()
        } else if (!evenement.shiftKey && actif === dernier) {
          evenement.preventDefault()
          premier.focus()
        }
      }
    })

    // Le panneau n'a plus lieu d'etre des que le menu deux colonnes s'affiche.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (vue) => {
      if (vue.matches && !menu.hidden) refermer()
    })
  }
</script>
