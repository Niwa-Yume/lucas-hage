---
import { lienRendezVous } from '@/lib/whatsapp'

const rendezVous = lienRendezVous()
---

<div
  class="fixed inset-x-0 bottom-0 z-30 border-t border-encre bg-papier md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={rendezVous}
    target="_blank"
    rel="noopener noreferrer"
    class="libelle block bg-encre px-4 py-4 text-center text-papier"
  >
    Prendre rendez-vous
  </a>
</div>
