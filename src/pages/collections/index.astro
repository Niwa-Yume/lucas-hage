---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { COLLECTIONS } from '@/data/collections'
---

<Layout
  title="Collections — Lucas Hage"
  description="Chevalières, New Chivalry, Memento Mori et Bestiaire : les quatre collections de l'atelier genevois de Lucas Hage."
  menuSurImage
>
  <PageHero
    titre="Quatre familles de pièces"
    image="/assets/campagne-chaines.jpg"
    alt="Pendentif ciselé en forme de cœur, suspendu à plusieurs chaînes en argent portées à même la peau, en noir et blanc."
    largeur={1600}
    hauteur={2400}
  >
    <p>À RÉDIGER</p>
  </PageHero>

  <section
    class="grid gap-x-5 gap-y-12 px-5 pb-section-mobile md:grid-cols-2 md:gap-x-8 md:gap-y-16 md:px-8 md:pb-section"
  >
    {
      COLLECTIONS.map((collection) => (
        <article>
          <a href={`/collections/${collection.slug}`} class="group block">
            <div class="bg-encre">
              <img
                src={collection.couverture}
                alt={collection.couvertureAlt}
                width={collection.couvertureLargeur}
                height={collection.couvertureHauteur}
                loading="lazy"
                class="aspect-[4/5] w-full object-cover"
              />
            </div>
            <h2 class="mt-5 font-titre text-intertitre leading-tight underline-offset-4 group-hover:underline">
              {collection.nom}
            </h2>
          </a>
          <p class="libelle mt-2">{collection.accroche}</p>
        </article>
      ))
    }
  </section>
</Layout>
