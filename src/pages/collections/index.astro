---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { COLLECTIONS } from '@/data/collections'
---

<Layout
  title="Collections — Lucas Hage"
  description="New chivalry, Terrible beauté, Memento mori et Alien : les quatre collections de l'atelier genevois de Lucas Hage, et son patrimoine."
  menuSurImage
>
  <PageHero
    titre="Les collections"
    image="/assets/inspiration-01.jpg"
    alt="Buste en veste noire, mains couvertes de bagues, bracelets et chaînes en argent."
    largeur={2400}
    hauteur={1600}
  >
    <p>
      Quatre collections, chacune avec son univers, et le patrimoine, qui garde
      la trace des pièces passées. Toutes sont façonnées à la main à l'atelier.
    </p>
  </PageHero>

  <section
    class="grid gap-x-5 gap-y-12 px-5 pb-section-mobile md:grid-cols-2 md:gap-x-8 md:gap-y-16 md:px-8 md:pb-section"
  >
    {
      COLLECTIONS.map((collection) => (
        <article>
          <a href={`/collections/${collection.slug}`} class="group block">
            <div class="bg-encre">
              <img
                src={collection.couverture}
                alt={collection.couvertureAlt}
                width={collection.couvertureLargeur}
                height={collection.couvertureHauteur}
                style={collection.couverturePosition && `object-position: ${collection.couverturePosition}`}
                loading="lazy"
                class="aspect-[4/5] w-full object-cover"
              />
            </div>
            <h2 class="mt-5 font-titre text-intertitre leading-tight underline-offset-4 group-hover:underline">
              {collection.nom}
            </h2>
          </a>
          <p class="libelle mt-2">{collection.accroche}</p>
        </article>
      ))
    }

    <!-- Patrimoine n'est pas une collection mais un statut de pièce :
         il reste hors de COLLECTIONS et se range ici, à la suite. -->
    <article>
      <a href="/collections/patrimoine" class="group block">
        <div class="bg-encre">
          <img
            src="/assets/cover-patrimoine.png"
            alt="Bague en argent en forme de poulpe, les tentacules enroulés autour d'une améthyste, sur fond noir."
            width="360"
            height="440"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <h2 class="mt-5 font-titre text-intertitre leading-tight underline-offset-4 group-hover:underline">
          Patrimoine
        </h2>
      </a>
      <p class="libelle mt-2">La mémoire de l'atelier</p>
    </article>
  </section>
</Layout>
