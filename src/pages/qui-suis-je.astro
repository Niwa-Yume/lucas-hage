---
import Layout from '@/layouts/Layout.astro'

const VIDEO = '/assets/qui-suis-je.mp4'
const POSTER_VIDEO = '/assets/qui-suis-je-poster.jpg'
const ATELIER = '/assets/atelier-lucas.jpg'
const CROQUIS = '/assets/atelier-croquis.jpg'
---

<Layout
  title="Qui suis-je — Lucas Hage"
  description="Lucas Hage, créateur et artisan joaillier suisse. Atelier à Genève, quartier des Grottes."
>
  <header class="px-5 pt-16 pb-10 md:px-8 md:pt-24 md:pb-16">
    <p class="libelle">Qui suis-je</p>
    <h1 class="mt-4 font-titre text-titre leading-tight md:text-hero">
      À RÉDIGER
    </h1>
  </header>

  <section
    class="grid items-center gap-10 px-5 pb-section-mobile md:grid-cols-2 md:gap-16 md:px-8 md:pb-section"
  >
    <img
      src={ATELIER}
      alt="Lucas Hage assis à l'atelier, carnet de croquis sur les genoux, bagues en argent aux doigts."
      width="2400"
      height="1600"
      loading="lazy"
      class="w-full"
    />
    <div>
      <h2 class="libelle">Le parcours</h2>
      <p class="mt-5 text-courant">À RÉDIGER</p>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </div>
  </section>

  <section
    class="grid items-center gap-10 px-5 pb-section-mobile md:grid-cols-2 md:gap-16 md:px-8 md:pb-section"
  >
    <div class="md:order-2">
      <h2 class="libelle">Le geste</h2>
      <p class="mt-5 text-courant">À RÉDIGER</p>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </div>
    <img
      src={CROQUIS}
      alt="Lucas Hage dessine au fusain deux projets de bijoux animaliers sur un carnet posé sur ses genoux."
      width="1920"
      height="2400"
      loading="lazy"
      class="w-full md:order-1"
    />
  </section>

  <section class="px-5 pb-section-mobile md:px-8 md:pb-section">
    <h2 class="libelle">En vidéo</h2>
    <video
      class="mt-5 w-full bg-encre"
      controls
      playsinline
      preload="none"
      poster={POSTER_VIDEO}
    >
      <source src={VIDEO} type="video/mp4" />
      Votre navigateur ne peut pas lire cette vidéo.
    </video>
  </section>

  <section class="px-5 pb-section-mobile md:px-8 md:pb-section">
    <h2 class="libelle">L'atelier</h2>
    <p class="mt-5 text-courant">
      L'atelier se trouve à Genève, dans le quartier des Grottes. Les rendez-vous
      se prennent directement par WhatsApp.
    </p>
    <p class="mt-4 text-courant">À RÉDIGER</p>
    <a
      href="/contact"
      class="libelle mt-8 inline-block border border-encre px-5 py-3 text-encre transition-colors hover:bg-encre hover:text-papier"
    >
      Prendre contact
    </a>
  </section>
</Layout>
