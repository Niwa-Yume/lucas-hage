---
import Layout from '@/layouts/Layout.astro'

const IMAGES = [
  {
    src: '/assets/inspiration-01.jpg',
    alt: "Buste en veste noire, mains couvertes de bagues, bracelets et chaînes en argent.",
    width: 2400,
    height: 1600,
  },
  {
    src: '/assets/hero-secondaire.jpg',
    alt: "Main portant cinq bagues en argent aux formes anguleuses, reliées par une chaîne, devant un visage.",
    width: 1600,
    height: 2400,
  },
  {
    src: '/assets/campagne-chaines.jpg',
    alt: "Pendentif ciselé en forme de cœur, suspendu à plusieurs chaînes en argent portées à même la peau, en noir et blanc.",
    width: 1600,
    height: 2400,
  },
  {
    src: '/assets/atelier-croquis.jpg',
    alt: "Lucas Hage dessine au fusain deux projets de bijoux animaliers sur un carnet posé sur ses genoux.",
    width: 1920,
    height: 2400,
  },
]
---

<Layout
  title="Inspiration — Lucas Hage"
  description="Les références, les matières et les images qui nourrissent les pièces de l'atelier."
>
  <header class="px-5 pt-16 pb-10 md:px-8 md:pt-24 md:pb-16">
    <p class="libelle">Inspiration</p>
    <h1 class="mt-4 font-titre text-titre leading-tight md:text-hero">
      À RÉDIGER
    </h1>
    <p class="mt-6 text-courant">À RÉDIGER</p>
  </header>

  <section
    class="grid gap-5 px-5 pb-section-mobile md:grid-cols-2 md:gap-8 md:px-8 md:pb-section"
  >
    {
      IMAGES.map((image) => (
        <figure>
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            class="w-full"
          />
          <figcaption class="libelle mt-3">À RÉDIGER</figcaption>
        </figure>
      ))
    }
  </section>
</Layout>
