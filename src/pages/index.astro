---
import Layout from '@/layouts/Layout.astro'
import { COLLECTIONS } from '@/data/collections'

// Les fichiers de public/assets/ contiennent des espaces : on encode l'URL.
const VIDEO_HERO = encodeURI('/assets/teaser v14 Lucas 2.mp4')
const POSTER_HERO = '/assets/image00015.PNG'
const ETABLI = '/assets/image00014.PNG'
---

<Layout
  title="Lucas Hage — Créateur et artisan suisse de bijoux sur mesure"
  description="Atelier de joaillerie à Genève, quartier des Grottes. Chevalières, pièces sur mesure et créations uniques, façonnées à la main."
>
  <section class="hero relative h-[100svh] w-full overflow-hidden bg-encre">
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={POSTER_HERO}
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={VIDEO_HERO} type="video/mp4" />
    </video>

    <img
      class="hero-repli absolute inset-0 h-full w-full object-cover"
      src={POSTER_HERO}
      alt="Chaînes en argent et pendentif ciselé portés à même la peau, en noir et blanc."
      width="813"
      height="1219"
    />

    <div
      class="relative flex h-full flex-col items-center justify-center px-5 text-center text-papier"
    >
      <h1 class="font-titre text-hero leading-none">LUCAS HAGE</h1>
      <p class="mt-5 text-courant">
        Créateur et artisan suisse de bijoux sur mesure
      </p>
    </div>
  </section>

  <section class="px-5 py-section-mobile md:px-8 md:py-section">
    <p class="libelle">Collections</p>
    <div class="mt-8 grid gap-x-5 gap-y-12 sm:grid-cols-2 md:grid-cols-4 md:gap-x-8">
      {
        COLLECTIONS.map((collection) => (
          <article>
            <a href={`/collections/${collection.slug}`} class="group block">
              <div class="bg-encre">
                <img
                  src={collection.couverture}
                  alt={collection.couvertureAlt}
                  width={collection.couvertureLargeur}
                  height={collection.couvertureHauteur}
                  loading="lazy"
                  class="aspect-[3/4] w-full object-cover"
                />
              </div>
              <h2 class="mt-4 font-titre text-intertitre leading-tight underline-offset-4 group-hover:underline">
                {collection.nom}
              </h2>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="grid items-center gap-10 px-5 pb-section-mobile md:grid-cols-2 md:gap-16 md:px-8 md:pb-section"
  >
    <img
      src={ETABLI}
      alt="L'établi de l'atelier : limes, bouterolles, boule de sertisseur et flacons de pierres sur les étagères."
      width="2652"
      height="3201"
      loading="lazy"
      class="w-full"
    />

    <div>
      <p class="libelle">Qui suis-je</p>
      <h2 class="mt-4 font-titre text-titre leading-tight">À RÉDIGER</h2>
      <p class="mt-6 text-courant">À RÉDIGER</p>
      <a
        href="/qui-suis-je"
        class="libelle mt-8 inline-block border border-encre px-5 py-3 text-encre hover:bg-encre hover:text-papier"
      >
        Découvrir l'atelier
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero-repli {
    display: none;
  }

  /* Mouvement réduit : le poster remplace la vidéo. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-repli {
      display: block;
    }
  }
</style>

<script>
  // Évite de télécharger et de lire la vidéo quand le mouvement est réduit.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector('.hero-video')?.remove()
  }
</script>
