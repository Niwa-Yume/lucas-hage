---
import Layout from '@/layouts/Layout.astro'
import { COLLECTIONS } from '@/data/collections'
import { lienRendezVous } from '@/lib/whatsapp'

const VIDEO_HERO = '/assets/hero.mp4'
const POSTER_HERO = '/assets/hero-poster.jpg'
const PORTRAIT = '/assets/portrait-lucas.jpg'
const rendezVous = lienRendezVous()
---

<Layout
  title="Lucas Hage — Créateur et artisan suisse de bijoux sur mesure"
  description="Atelier de joaillerie à Genève, quartier des Grottes. Chevalières, pièces sur mesure et créations uniques, façonnées à la main."
>
  <section class="hero relative h-[100svh] w-full overflow-hidden bg-encre">
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={POSTER_HERO}
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={VIDEO_HERO} type="video/mp4" />
    </video>

    <!-- Voile sombre : garantit la lisibilite du titre quelle que soit l'image. -->
    <div class="absolute inset-0 bg-encre/35" aria-hidden="true"></div>

    <img
      class="hero-repli absolute inset-0 h-full w-full object-cover"
      src={POSTER_HERO}
      alt="Lucas Hage, penché sur son établi éclairé, façonne une pièce à la main dans l'atelier."
      width="1920"
      height="1080"
    />

    <div
      class="relative flex h-full flex-col items-center justify-center px-5 text-center text-papier"
    >
      <h1 class="font-titre text-hero leading-none">LUCAS HAGE</h1>
      <p class="mt-5 text-courant">
        Créateur et artisan suisse de bijoux sur mesure
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/collections"
          class="libelle border border-papier px-6 py-4 text-papier transition-colors hover:bg-papier hover:text-encre"
        >
          Voir les collections
        </a>
        <a
          href={rendezVous}
          target="_blank"
          rel="noopener noreferrer"
          class="libelle border border-papier bg-papier px-6 py-4 text-encre transition-colors hover:bg-transparent hover:text-papier"
        >
          Prendre rendez-vous
        </a>
      </div>
    </div>
  </section>

  <section class="px-5 py-section-mobile md:px-8 md:py-section">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="libelle">Collections</h2>
      <a href="/collections" class="libelle underline-offset-4 hover:underline">
        Tout voir
      </a>
    </div>
    <div class="mt-8 grid gap-x-5 gap-y-12 sm:grid-cols-2 md:grid-cols-4 md:gap-x-8">
      {
        COLLECTIONS.map((collection) => (
          <article>
            <a href={`/collections/${collection.slug}`} class="group block">
              <div class="bg-encre">
                <img
                  src={collection.couverture}
                  alt={collection.couvertureAlt}
                  width={collection.couvertureLargeur}
                  height={collection.couvertureHauteur}
                  loading="lazy"
                  class="aspect-[3/4] w-full object-cover"
                />
              </div>
              <h3 class="mt-4 font-titre text-intertitre leading-tight underline-offset-4 group-hover:underline">
                {collection.nom}
              </h3>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="grid items-center gap-10 px-5 pb-section-mobile md:grid-cols-2 md:gap-16 md:px-8 md:pb-section"
  >
    <img
      src={PORTRAIT}
      alt="Lucas Hage, loupe de joaillier relevée sur le front, travaille une pièce à sa table de dessin."
      width="2400"
      height="1600"
      loading="lazy"
      class="w-full"
    />

    <div>
      <p class="libelle">Qui suis-je</p>
      <h2 class="mt-4 font-titre text-titre leading-tight">À RÉDIGER</h2>
      <p class="mt-6 text-courant">À RÉDIGER</p>
      <a
        href="/qui-suis-je"
        class="libelle mt-8 inline-block border border-encre px-5 py-3 text-encre hover:bg-encre hover:text-papier"
      >
        Découvrir l'atelier
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero-repli {
    display: none;
  }

  /* Mouvement réduit : le poster remplace la vidéo. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-repli {
      display: block;
    }
  }
</style>

<script>
  // Évite de télécharger et de lire la vidéo quand le mouvement est réduit.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector('.hero-video')?.remove()
  }
</script>
