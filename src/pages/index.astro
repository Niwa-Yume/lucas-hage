---
import Layout from '@/layouts/Layout.astro'
import { COLLECTIONS } from '@/data/collections'

const VIDEO_HERO = '/assets/hero.webm'
const POSTER_HERO = '/assets/hero-poster.jpg'

// Un bandeau pleine largeur, deux colonnes, puis le bandeau « Qui suis-je ».
const [bandeauHaut, colonneGauche, colonneDroite] = COLLECTIONS
const enColonnes = [colonneGauche, colonneDroite].filter(Boolean)
---

<Layout
  title="Lucas Hage — Créateur et artisan suisse de bijoux sur mesure"
  description="Atelier de joaillerie à Genève, quartier des Grottes. Chevalières, pièces sur mesure et créations uniques, façonnées à la main."
  menuSurImage
>
  <section class="hero relative h-[100svh] w-full overflow-hidden bg-encre">
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={POSTER_HERO}
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={VIDEO_HERO} type="video/webm" />
    </video>

    <img
      class="hero-repli absolute inset-0 h-full w-full object-cover"
      src={POSTER_HERO}
      alt="Lucas Hage, de dos, au travail devant son établi éclairé dans l'atelier."
      width="1920"
      height="1080"
    />

    <div
      class="relative flex h-full flex-col items-center justify-center px-5 text-center text-papier"
    >
      <h1 class="font-titre text-hero leading-none">LUCAS HAGE</h1>
      <p class="mt-5 text-courant">
        Créateur et artisan suisse de bijoux sur mesure
      </p>
    </div>
  </section>

  {
    bandeauHaut && (
      <section class="relative w-full overflow-hidden bg-encre">
        <img
          src={bandeauHaut.couverture}
          alt={bandeauHaut.couvertureAlt}
          width={bandeauHaut.couvertureLargeur}
          height={bandeauHaut.couvertureHauteur}
          loading="lazy"
          class="block h-auto w-full"
        />
        <div class="bandeau-legende absolute inset-x-0 bottom-[12%] px-5 text-center">
          <p class="bandeau-nom">{bandeauHaut.nom}</p>
          <a href={`/collections/${bandeauHaut.slug}`} class="lien-decouvrir">
            Découvrir
          </a>
        </div>
      </section>
    )
  }

  <section class="px-5 py-40 md:px-8 md:py-[16rem]">
    <div
      class="flex flex-col items-center gap-24 md:flex-row md:items-start md:justify-center md:gap-[12vw]"
    >
      {
        enColonnes.map((collection) => (
          <article class="w-full max-w-sm md:w-[30vw] md:max-w-none">
            <div class="bg-encre">
              <img
                src={collection.couverture}
                alt={collection.couvertureAlt}
                width={collection.couvertureLargeur}
                height={collection.couvertureHauteur}
                loading="lazy"
                class="aspect-[3/4] w-full object-cover"
              />
            </div>
            <h2 class="colonne-nom">{collection.nom}</h2>
            <a
              href={`/collections/${collection.slug}`}
              class="lien-decouvrir lien-decouvrir-encre"
            >
              Découvrir
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="relative h-[70vh] w-full overflow-hidden bg-encre">
    <img
      src="/assets/hero-poster.jpg"
      alt="Lucas Hage, de dos, au travail devant son établi éclairé dans l'atelier."
      width="1920"
      height="1080"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="bandeau-legende absolute inset-x-0 bottom-[12%] px-5 text-center">
      <p class="bandeau-nom">Qui suis-je</p>
      <a href="/qui-suis-je" class="lien-decouvrir">Découvrir</a>
    </div>
  </section>
</Layout>

<style>
  .hero-repli {
    display: none;
  }

  /* Mouvement réduit : le poster remplace la vidéo. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
    .hero-repli {
      display: block;
    }
  }

  /* Nom de collection en capitales blanches, pose sur le bandeau. */
  .bandeau-legende {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .bandeau-nom {
    margin: 0;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    font-size: var(--text-intertitre);
    color: var(--color-papier);
  }

  .bandeau-legende .lien-decouvrir {
    margin-top: 0;
  }

  .colonne-nom {
    margin-top: 1.5rem;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
    font-size: var(--text-libelle);
    color: var(--color-encre);
  }

  .lien-decouvrir {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: var(--text-libelle);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-papier);
  }

  .lien-decouvrir-encre {
    display: block;
    text-align: center;
    color: var(--color-encre);
  }
</style>

<script>
  // Évite de télécharger et de lire la vidéo quand le mouvement est réduit.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelector('.hero-video')?.remove()
  }
</script>
