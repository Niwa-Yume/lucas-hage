---
import Layout from '@/layouts/Layout.astro'
---

<Layout
  title="Mentions légales — Lucas Hage"
  description="Mentions légales du site lucas-hage.com : éditeur, hébergeur, propriété intellectuelle."
>
  <header class="px-5 pt-10 pb-10 md:px-8 md:pt-14 md:pb-16">
    <p class="libelle">Informations légales</p>
    <h1 class="mt-4 font-titre text-titre leading-tight">Mentions légales</h1>
  </header>

  <div class="px-5 pb-section-mobile md:px-8 md:pb-section">
    <section class="mb-10">
      <h2 class="libelle">Éditeur du site</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>

    <section class="mb-10">
      <h2 class="libelle">Responsable de la publication</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>

    <section class="mb-10">
      <h2 class="libelle">Hébergement</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>

    <section class="mb-10">
      <h2 class="libelle">Propriété intellectuelle</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>

    <section class="mb-10">
      <h2 class="libelle">Crédits photographiques</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>

    <section>
      <h2 class="libelle">Droit applicable</h2>
      <p class="mt-4 text-courant">À RÉDIGER</p>
    </section>
  </div>
</Layout>
