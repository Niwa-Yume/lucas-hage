---
import Layout from '@/layouts/Layout.astro'
import PageHero from '@/components/PageHero.astro'
import { lienSurMesure } from '@/lib/whatsapp'

const surMesure = lienSurMesure()

// TEXTE A VALIDER AVEC LUCAS : deroule, delais et prix sont rediges
// de maniere prudente, sans engagement chiffre.
const ETAPES = [
  {
    titre: 'Le premier échange',
    texte:
      "Vous m'écrivez sur WhatsApp : une idée, une référence, une pierre à " +
      'remonter, un bijou de famille à transformer. Quelques photos suffisent ' +
      'pour commencer.',
  },
  {
    titre: 'Le rendez-vous',
    texte:
      "Nous nous retrouvons à l'atelier, à Cornavin, pour parler de la pièce, " +
      'des matières et de la façon dont vous la porterez. On y prend aussi vos ' +
      'mesures.',
  },
  {
    titre: 'Le dessin',
    texte:
      'Je dessine la pièce à la main. Le croquis évolue avec vos retours, ' +
      "jusqu'à ce qu'il vous ressemble.",
  },
  {
    titre: 'Le façonnage',
    texte:
      "La pièce est façonnée à la main à l'atelier, du travail du métal " +
      'au sertissage des pierres.',
  },
  {
    titre: 'La remise',
    texte: "Vous découvrez votre pièce à l'atelier, terminée.",
  },
]
---

<Layout
  title="Sur mesure — Lucas Hage"
  description="Une pièce dessinée et façonnée à la main pour vous, dans l'atelier de Lucas Hage à Cornavin, au centre de Genève."
  image="/assets/portrait-lucas.jpg"
  menuSurImage
>
  <PageHero
    titre="Le sur-mesure"
    image="/assets/portrait-lucas.jpg"
    alt="Lucas Hage dessine un projet à sa table de l'atelier, entouré de croquis, d'un crâne sculpté et de flacons."
    largeur={2400}
    hauteur={1600}
  >
    <p>
      Une pièce sur mesure part d'une conversation. Une idée, un symbole, une
      pierre qui vous appartient déjà : je la dessine avec vous, puis je la
      façonne à la main, pour qu'elle n'existe qu'une fois.
    </p>
  </PageHero>

  <section class="px-5 pb-section-mobile md:px-8 md:pb-section">
    <h2 class="libelle">Comment ça se passe</h2>

    <ol class="mt-10 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
      {
        ETAPES.map((etape, index) => (
          <li class="border-t border-encre pt-5">
            <p class="libelle">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 font-titre text-intertitre leading-tight">
              {etape.titre}
            </h3>
            <p class="mt-3 text-courant">{etape.texte}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Photo en portrait : entière, à son format, sans cadre ni recadrage. -->
  <div class="flex justify-center px-5 md:px-8">
    <img
      src="/assets/atelier-etabli.jpg"
      alt="Étagères de l'atelier en bois brut : bouterolles, dés à emboutir, boule à sertir, tubes de pierres et chaînes en cuivre."
      width="1988"
      height="2400"
      loading="lazy"
      class="block h-auto w-full max-w-sm md:w-[30vw] md:max-w-none"
    />
  </div>

  <section
    class="grid gap-12 px-5 py-section-mobile md:grid-cols-2 md:gap-16 md:px-8 md:py-section"
  >
    <div>
      <h2 class="libelle">Les matières</h2>
      <p class="mt-5 text-courant">
        Argent, or jaune, blanc ou rose, bronze. Les pierres se choisissent
        ensemble, ou viennent de vous : une pierre héritée peut trouver une
        nouvelle monture.
      </p>
    </div>

    <div>
      <h2 class="libelle">Prix et délais</h2>
      <p class="mt-5 text-courant">
        Chaque pièce est unique : son prix et son délai dépendent du dessin,
        des matières et des pierres. Nous les fixons ensemble avant que le
        travail commence.
      </p>
    </div>
  </section>

  <section class="border-t border-encre px-5 py-section-mobile md:px-8 md:py-section">
    <h2 class="libelle">Parlons de votre pièce</h2>
    <p class="mt-5 text-courant">
      Le plus simple est de m'écrire. Je vous réponds pour convenir d'un
      rendez-vous à l'atelier.
    </p>
    <a
      href={surMesure}
      target="_blank"
      rel="noopener noreferrer"
      class="libelle mt-7 inline-block border border-encre bg-encre px-6 py-4 text-papier hover:bg-papier hover:text-encre"
    >
      Écrire sur WhatsApp
    </a>
  </section>
</Layout>
